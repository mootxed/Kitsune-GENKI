{
  "name": "kotokitsu",
  "productName": "KotoKitsu",
  "version": "0.1.0-alpha",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Offline-first Japanese learning PWA with spaced repetition",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:kanji": "node scripts/build-kanji-data.js",
    "legal:prepare": "node scripts/copy-third-party-licenses.js",
    "legal:check": "node scripts/check-legal-metadata.js",
    "validate:grammar-quizzes": "node scripts/validate-grammar-quizzes.js",
    "prebuild": "node scripts/copy-third-party-licenses.js && node scripts/validate-grammar-quizzes.js && node scripts/build-kanji-data.js && node scripts/check-legal-metadata.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs-links.js",
    "prepare": "husky"
  },
  "keywords": [
    "japanese",
    "learning",
    "pwa",
    "fsrs",
    "spaced-repetition",
    "offline-first",
    "japanese-vocabulary"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "terser": "^5.49.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@k1low/hanzi-writer-data-jp": "0.8.0",
    "hanzi-writer": "3.7.3",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
