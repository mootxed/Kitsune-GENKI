{
  "name": "kotokitsu",
  "productName": "KotoKitsu",
  "version": "0.1.0-alpha",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Offline-first Japanese learning PWA with spaced repetition",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:isolate-sourcemaps": "node scripts/isolate-sourcemaps.js",
    "build:check-sourcemaps": "node scripts/check-sourcemap-policy.js",
    "performance:check": "node scripts/check-performance-budgets.js",
    "build:analyze": "vite build --mode analyze",
    "build:dictionary": "node scripts/build-dictionary.js",
    "build:kanji": "node scripts/build-kanji-data.js",
    "legal:prepare": "node scripts/copy-third-party-licenses.js",
    "legal:check": "node scripts/check-legal-metadata.js",
    "content:audit": "node scripts/audit-content.js",
    "content:coverage": "node scripts/generate-content-coverage.js",
    "content:check": "node scripts/audit-content.js && node scripts/generate-content-coverage.js --check",
    "content:release-check": "node scripts/check-content-release.js",
    "validate:grammar-quizzes": "node scripts/validate-grammar-quizzes.js",
    "validate:genki": "node scripts/validate-genki-i-data.js",
    "validate:courses": "node scripts/validate-courses.js",
    "validate:dictionary": "node scripts/validate-dictionary.js",
    "import:genki": "node scripts/import-genki-i-data.js",
    "fixtures:verify": "node scripts/verify-fixtures.js",
    "prebuild": "node scripts/verify-fixtures.js && node scripts/copy-third-party-licenses.js && node scripts/validate-dictionary.js && node scripts/validate-courses.js && node scripts/validate-grammar-quizzes.js && node scripts/validate-genki-i-data.js && node scripts/audit-content.js && node scripts/generate-content-coverage.js --check && node scripts/build-kanji-data.js && node scripts/check-legal-metadata.js",
    "preview": "vite preview",
    "postbuild": "node scripts/isolate-sourcemaps.js && node scripts/check-performance-budgets.js && node scripts/check-sourcemap-policy.js && node scripts/generate-build-manifest.js",
    "test": "vitest run",
    "test:migrations": "vitest run tests/migrations",
    "test:migrations:e2e": "playwright test tests/e2e/migrations",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:chromium": "playwright test --project=\"Desktop Chrome\" --project=\"Mobile Chrome\"",
    "test:e2e:cross-browser": "playwright test --grep @smoke --project=\"Desktop Chrome\" --project=firefox --project=webkit",
    "test:e2e:pwa": "playwright test --grep @pwa --project=\"Desktop Chrome\" --project=\"Mobile Chrome\"",
    "test:e2e:offline": "playwright test --grep @offline --project=\"Desktop Chrome\" --project=\"Mobile Chrome\"",
    "test:e2e:storage": "playwright test --grep @storage --project=\"Desktop Chrome\" --project=\"Mobile Chrome\"",
    "test:e2e:multitab": "playwright test --grep @multitab --project=\"Desktop Chrome\" --project=\"Mobile Chrome\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:cycles": "depcruise --config dependency-cruiser.config.cjs --validate src state ui bootstrap adapters app.js",
    "architecture:boundaries": "depcruise --config dependency-cruiser.config.cjs src state ui bootstrap adapters app.js",
    "architecture:globals": "node scripts/check-legacy-globals.js",
    "architecture:check": "npm run architecture:cycles && npm run architecture:boundaries && npm run architecture:globals",
    "docs:generate": "node scripts/generate-reference-docs.js",
    "docs:check": "node scripts/check-docs-links.js",
    "security:check": "node scripts/security-audit.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "prepare": "husky"
  },
  "keywords": [
    "japanese",
    "learning",
    "pwa",
    "fsrs",
    "spaced-repetition",
    "offline-first",
    "japanese-vocabulary"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "dependency-cruiser": "^18.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "terser": "^5.49.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@k1low/hanzi-writer-data-jp": "0.8.0",
    "hanzi-writer": "3.7.3",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
